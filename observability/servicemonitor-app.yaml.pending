# 작성자: 최유준
# 최초 작성: 2026-08-28
# Current State 현행화: GitOps #86
#
# [보류 중]
# Backend Service는 현재 apps/backend/service.yaml에 존재하고 GitOps 관리 대상에 편입되어 있습니다.
# 다만 Backend Runtime은 아직 replicas: 0 / git-pending 상태이며 /metrics 제공과 Prometheus 수집은
# 실제 Runtime에서 검증되지 않았으므로 이 파일은 .pending으로 유지합니다.
#
# 재활성화 조건은 observability/README.md "Application ServiceMonitor 보류"를 따릅니다.
apiVersion: monitoring.coreos.com/v1
kind: ServiceMonitor
metadata:
  name: seokpan-app-metrics
  namespace: observability
  labels:
    release: kube-prometheus-stack
spec:
  namespaceSelector:
    matchNames:
      - application
  selector:
    matchLabels:
      app.kubernetes.io/name: backend
  endpoints:
    - port: http
      path: /metrics
      interval: 15s
